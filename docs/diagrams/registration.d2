vars: { d2-config: { layout-engine: elk; sketch: true; pad: 16 } }
direction: down

classes: {
  ext:   { style: { stroke: "#E65100"; stroke-width: 2; stroke-dash: 3 } }
  core:  { style: { stroke: "#1565C0"; stroke-width: 2 } }
  store: { shape: cylinder; style: { stroke: "#2E7D32"; stroke-width: 2 } }
}

manifestA: "repo A's\nhookyard.json" { class: ext }
manifestB: "repo B's\nhookyard.json" { class: ext }
install: "hookyard install\n(marker-scoped strip)" { class: core }
emit: "hookyard emit\n(opaque-JSON merge)" { class: core }
codexCfg: "Codex\nconfig.toml" { class: ext }
cursorCfg: "Cursor\nhooks.json" { class: ext }
piBridge: "Pi bridge\nextension (.ts)" { class: ext }
piCfg: "Pi settings.json\nextensions[] entry" { class: ext }
overlay: "Claude Code\n--settings overlay" { class: store }
table: "state table" { class: store }

manifestA -> install
manifestB -> install
manifestA -> emit
manifestB -> emit
install -> codexCfg
install -> cursorCfg
install -> piBridge: generate\n(whole file)
install -> piCfg: register bridge path
install -> table: record handlers
emit -> overlay: Nix places
